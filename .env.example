# Resend API key, from https://resend.com/api-keys. Required to send notification emails.
RESEND_API_KEY=

# Mailbox that receives change notifications.
NOTIFY_TO_EMAIL=

# Sender address, must be verified in your Resend account (e.g. alerts@yourdomain.com).
NOTIFY_FROM_EMAIL=

# Amadeus for Developers self-service API credentials (free tier), from
# https://developers.amadeus.com/my-apps. Used by flights.py for flight price checks.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
